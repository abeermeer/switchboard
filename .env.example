# ── Switchboard ───────────────────────────────────────────────────────────────
# Every value here is optional. Switchboard generates safe defaults on first run.

# HTTP port for both the gateway (/v1) and the dashboard.
PORT=7272

# Interface server.mjs listens on. 127.0.0.1 keeps it on this machine; 0.0.0.0
# puts it on your network (remote callers then need the dashboard token from
# `sb token`, and an API key for /v1).
# SWITCHBOARD_HOST=127.0.0.1

# Where the SQLite database, key vault and logs live.
# `sb start` and the desktop app default to the OS app-data folder;
# `npm start` and `npm run dev` default to ./data.
# SWITCHBOARD_DATA_DIR=./data

# 32-byte master key (base64) used to encrypt provider credentials at rest.
# Leave unset — Switchboard generates one into <data-dir>/master.key on boot.
# SWITCHBOARD_MASTER_KEY=

# Set to 1 only when your own front door (a reverse proxy with auth, a tunnel)
# already decides who gets in: remote callers then reach the dashboard without
# the token, and the gateway without a key until one exists.
# SWITCHBOARD_ALLOW_REMOTE=0

# Hostnames to answer besides IP addresses and localhost, e.g. a reverse
# proxy's name. Anything else is refused, which is what stops DNS rebinding.
# SWITCHBOARD_ALLOWED_HOSTS=switchboard.example

# Origins allowed to call /v1 from a browser. Empty (the default) means none:
# the endpoint is built for server-side SDK clients, which are unaffected by
# CORS. Set this only if a browser app calls the gateway directly, and list the
# exact origins — `*` would let any page you visit spend your provider
# credentials once it learned a key.
# SWITCHBOARD_CORS_ORIGINS=http://localhost:3000,https://myapp.example

# Log verbosity: debug | info | warn | error | silent.
# Defaults to info in production, debug otherwise.
# SWITCHBOARD_LOG_LEVEL=info

# Log format: json | pretty. Defaults to pretty in a TTY, json when captured.
# SWITCHBOARD_LOG_FORMAT=json
