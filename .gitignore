# Runtime state. `data/` covers all of this, but secrets should never depend on
# a single rule holding — a stray copy of master.key outside data/ would leak
# every stored provider credential.
data/
master.key
*.key
*.db
*.db-wal
*.db-shm

.env
.env.local
.env.*.local

*.log
.DS_Store
Thumbs.db
next-env.d.ts
tsconfig.tsbuildinfo

# Brag video source assets. The rendered brag.mp4 embeds them as intended use,
# but the raw music/SFX files are third-party licensed and are not ours to
# redistribute in a public repo. Regenerate from the /brag skill assets.
brag-output/composition/assets/
brag-output/composition/vendor/

